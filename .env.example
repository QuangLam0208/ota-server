# Copy this file to .env and fill in a real value. .env is gitignored — never commit it.

# Secret token clients must send in the `x-publish-token` header to publish
# a new update via POST /publish. If unset, that endpoint is disabled (501).
# The publishing client (react-native-demo/scripts/.env.example's
# OTA_PUBLISH_TOKEN) must be set to this same value.
PUBLISH_TOKEN=

# Code Signing configuration (optional — if omitted, uses ./keys/private-key.pem if present, or unsigned mode)
# PRIVATE_KEY_PATH=./keys/private-key.pem
# KEY_ID=main

# Only needed if you use the optional `ngrok` service in docker-compose.yml
# to expose this server publicly without your own domain. See README.md ->
# "Exposing it publicly without your own domain (ngrok)".
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
